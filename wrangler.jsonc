{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duotyping-landing",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
}
